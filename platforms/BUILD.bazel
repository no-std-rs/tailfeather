# BuildBuddy's managed Ubuntu 24.04 executor. This is the digest-pinned image
# shared with Shaggy; target selection remains independent of execution.
platform(
    name = "rbe_linux_amd64",
    exec_properties = {
        "Arch": "amd64",
        "OSFamily": "Linux",
        "container-image": "docker://docker.io/library/ubuntu@sha256:019e8eb29a85e74d64925745884f2ec79aa27e3feab36353d24656f4d6b89467",
        "use-self-hosted-executors": "false",
    },
    parents = ["@rules_rs//rs/platforms:x86_64-unknown-linux-gnu"],
)
