load("@tailfeather_root_deps//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test")

package(default_visibility = ["//visibility:public"])

filegroup(name = "rust_sources", srcs = glob(["src/**/*.rs"]))

rust_library(
    name = "micro_h2",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "micro_h2",
    edition = "2024",
    deps = all_crate_deps(normal = True),
)

rust_library(
    name = "micro_h2_harness",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "micro_h2",
    edition = "2024",
    rustc_flags = ["-Cpanic=abort"],
    deps = ["@harness_deps//:heapless-0.9.3"],
)

rust_library(
    name = "micro_h2_firmware",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "micro_h2",
    edition = "2024",
    rustc_flags = ["-Cpanic=abort"],
    deps = ["@firmware_deps//:heapless-0.9.3"],
)

alias(
    name = "micro-h2",
    actual = ":micro_h2",
)

rust_test(
    name = "unit_test",
    crate = ":micro_h2",
)

rust_doc_test(
    name = "doc_test",
    crate = ":micro_h2",
)

rust_doc(
    name = "docs",
    crate = ":micro_h2",
    rustdoc_flags = ["-Dwarnings"],
)
