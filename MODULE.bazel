module(
    name = "tailfeather",
    version = "0.0.1",
)

bazel_dep(name = "llvm", version = "0.8.16")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_python", version = "2.2.0")
bazel_dep(name = "rules_rs", version = "0.0.102")
bazel_dep(name = "rules_shell", version = "0.6.1")

# rules_llvm otherwise fetches musl only from musl.libc.org. That origin is
# intermittently unreachable from the privileged BuildBuddy runner, so keep
# the byte-identical Buildroot source mirror ahead of the upstream URL.
single_version_override(
    module_name = "llvm",
    patch_strip = 1,
    patches = ["//bazel/patches:llvm-musl-mirror.patch"],
    version = "0.8.16",
)

single_version_override(
    module_name = "rules_rs",
    patch_strip = 1,
    patches = [
        "//bazel/patches:rules_rs-build-script-link-deps.patch",
        "//bazel/patches:rules_rs-zlib-ubuntu-snapshot.patch",
    ],
    version = "0.0.102",
)

rust_toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
rust_toolchains.toolchain(
    edition = "2024",
    version = "1.95.0",
)
use_repo(rust_toolchains, "default_rust_toolchains")

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.13")
use_repo(python, "python_3_13")

register_toolchains(
    "@default_rust_toolchains//:all",
    "@llvm//toolchain:all",
    "@python_3_13//:all",
)

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "tailfeather_root_deps",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
    ],
)
crate.annotation(
    crate = "micro-h2",
    repositories = ["harness_deps", "firmware_deps"],
    rustc_flags = ["-Cpanic=abort"],
)
crate.annotation(
    crate = "embedded-tls",
    repositories = ["harness_deps"],
    rustc_flags = ["-Cpanic=abort"],
)
crate.annotation(
    crate = "rustix",
    repositories = ["harness_deps"],
    rustc_flags = ["-Cpanic=abort"],
)
crate.annotation(
    crate = "esp-hal",
    patch_args = ["-p1"],
    patches = ["//bazel/patches:esp-hal-esp32c6-ram-length.patch"],
    repositories = ["firmware_deps"],
)
crate.annotation(
    crate = "esp-metadata-generated",
    patch_args = ["-p1"],
    patches = ["//bazel/patches:esp-metadata-generated-cross.patch"],
    repositories = ["firmware_deps"],
)
crate.from_cargo(
    name = "harness_deps",
    cargo_lock = "//harness:Cargo.lock",
    cargo_toml = "//harness:Cargo.toml",
    platform_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)
crate.from_cargo(
    name = "firmware_deps",
    cargo_lock = "//firmware:Cargo.lock",
    cargo_toml = "//firmware:Cargo.toml",
    platform_triples = [
        "riscv32imac-unknown-none-elf",
        "x86_64-unknown-linux-gnu",
    ],
)
crate.from_cargo(
    name = "ssh_probe_deps",
    cargo_lock = "//crates/tailfeather-ssh/probe:Cargo.lock",
    cargo_toml = "//crates/tailfeather-ssh/probe:Cargo.toml",
    platform_triples = ["x86_64-unknown-linux-gnu"],
)
use_repo(crate, "firmware_deps", "harness_deps", "ssh_probe_deps", "tailfeather_root_deps")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

