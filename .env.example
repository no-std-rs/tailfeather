# Copy to .env and fill in. .env is gitignored; never commit real credentials.

WIFI_SSID=your-network
WIFI_PASSWORD=your-password

# Supply a reusable, pre-authorized Tailscale auth key. The script validates
# the selected board before compiling this credential into a local-only build.
TS_AUTH_KEY=tskey-auth-replace-me

# Tailscale Cloud is the default. Use the base URL of a Headscale server here.
TS_CONTROL_URL=https://controlplane.tailscale.com
TS_HOSTNAME=esp-gateway

# Optional DER-encoded private CA for Headscale. Leave empty for the hosted
# service's built-in trust anchor.
TS_CONTROL_CA_DER=
