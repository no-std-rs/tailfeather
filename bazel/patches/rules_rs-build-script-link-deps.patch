diff --git a/rs/rust_crate.bzl b/rs/rust_crate.bzl
index bd47a92..af7ad7a 100644
--- a/rs/rust_crate.bzl
+++ b/rs/rust_crate.bzl
@@ -46,4 +46,42 @@ def rust_crate(
         extra_compile_data = [],
         rustc_env = {},
         skip_deps_verification = False):
+    # portable-atomic rejects its single-core fallback on the Linux execution
+    # host. rules_rs 0.0.102 can place that target feature in the shared set.
+    if name == "portable-atomic" and "unsafe-assume-single-core" in crate_features and "riscv32imac-unknown-none-elf" in triples and "x86_64-unknown-linux-gnu" in triples:
+        crate_features = [feature for feature in crate_features if feature != "unsafe-assume-single-core"]
+        conditional_crate_features = dict(conditional_crate_features)
+        conditional_crate_features["riscv32imac-unknown-none-elf"] = (
+            conditional_crate_features.get("riscv32imac-unknown-none-elf", []) +
+            ["unsafe-assume-single-core"]
+        )
+    # log 0.4.29+ exposes std as its compatibility default. ESP crates still
+    # rely on the historical no_std default, while host-side generators use it.
+    if name == "log" and "riscv32imac-unknown-none-elf" in triples and "x86_64-unknown-linux-gnu" in triples:
+        host_features = [feature for feature in crate_features if feature in ["default", "std"]]
+        if host_features:
+            crate_features = [feature for feature in crate_features if feature not in host_features]
+            conditional_crate_features = dict(conditional_crate_features)
+            conditional_crate_features["x86_64-unknown-linux-gnu"] = (
+                conditional_crate_features.get("x86_64-unknown-linux-gnu", []) +
+                host_features
+            )
+    # Proc macros execute on the host, but Cargo resolves their features from
+    # target dependency edges. A platform select would otherwise drop them.
+    if is_proc_macro and conditional_crate_features:
+        for features in conditional_crate_features.values():
+            for feature in features:
+                if feature not in crate_features:
+                    crate_features.append(feature)
+        conditional_crate_features = {}
+    # esp-hal's proc macro consumes object on the host with features selected
+    # by the ESP target edge. Mirror those features into the execution branch.
+    if name == "object" and "riscv32imac-unknown-none-elf" in conditional_crate_features and "x86_64-unknown-linux-gnu" in triples:
+        target_features = conditional_crate_features["riscv32imac-unknown-none-elf"]
+        conditional_crate_features = dict(conditional_crate_features)
+        conditional_crate_features["x86_64-unknown-linux-gnu"] = (
+            conditional_crate_features.get("x86_64-unknown-linux-gnu", []) +
+            [feature for feature in target_features if feature not in conditional_crate_features.get("x86_64-unknown-linux-gnu", [])]
+        )
+
     package_metadata(
@@ -53,6 +53,10 @@ def rust_crate(
             "BUILD",
             "BUILD.bazel",
             "REPO.bazel",
+            # Some crates ship an empty marker file with the same name as the
+            # generated Bazel target (for example esp-phy). Bazel resolves that
+            # file label to the target and creates a self-edge.
+            name,
             "Cargo.toml.orig",
             "WORKSPACE",
             "WORKSPACE.bazel",
@@ -92,6 +92,11 @@ def rust_crate(
             links = links,
             data = compile_data + build_script_data,
-            link_deps = deps,
+            # Cargo build scripts compile with build-dependencies only. Feeding
+            # every target dependency through link_deps creates an analysis
+            # cycle for esp-radio -> esp-phy -> esp-hal while cross-compiling.
+            # Native link metadata still propagates through each crate's own
+            # generated build-script provider.
+            link_deps = [],
             build_script_env = build_script_env,
             allow_build_script_to_detect_nonhermetic_paths = allow_build_script_to_detect_nonhermetic_paths,
             build_script_env_files = ["cargo_toml_env_vars.env"],
