{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pawelchcki/tailfeather/release/evidence.schema.json",
  "title": "tailfeather 0.1 release evidence",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^(https://|artifacts/).+"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  },
  "required": [
    "schema_version", "commit", "created_at", "references", "baseline_hashes",
    "runs", "resources", "cleanup", "permission_reviews"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headscale", "tailscaled"],
      "properties": {
        "headscale": { "const": "v0.29.3" },
        "tailscaled": { "const": "1.94.2" }
      }
    },
    "baseline_hashes": {
      "type": "object",
      "required": ["offline", "headscale", "hosted"],
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "runs": {
      "type": "array", "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "run_id", "artifact", "commit", "result"],
        "properties": {
          "kind": { "enum": ["headscale", "hosted", "hardware", "adversarial"] },
          "run_id": { "type": "string", "minLength": 1 },
          "device_id": { "type": "string" },
          "artifact": { "$ref": "#/$defs/artifact" },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "result": { "const": "pass" }
        }
      },
      "allOf": [
        { "contains": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "headscale" } } } },
        { "contains": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "hosted" } } } },
        { "contains": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "hardware" } } } },
        { "contains": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "adversarial" } } } }
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ram_bytes", "image_bytes", "radio_heap_bytes",
        "minimum_stack_headroom_percent", "artifact"
      ],
      "properties": {
        "ram_bytes": { "type": "integer", "minimum": 1, "maximum": 204800 },
        "image_bytes": { "type": "integer", "minimum": 1, "maximum": 1572864 },
        "radio_heap_bytes": { "const": 65536 },
        "minimum_stack_headroom_percent": {
          "type": "integer", "minimum": 25, "maximum": 100
        },
        "artifact": { "$ref": "#/$defs/artifact" }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "artifact"],
      "properties": {
        "result": { "const": "pass" },
        "artifact": { "$ref": "#/$defs/artifact" }
      }
    },
    "permission_reviews": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wireguard", "tailscale"],
      "properties": {
        "wireguard": { "type": "string", "minLength": 1 },
        "tailscale": { "type": "string", "minLength": 1 }
      }
    }
  }
}
