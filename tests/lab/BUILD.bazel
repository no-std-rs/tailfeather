# Inputs every privileged guest needs: the pinned VM, its userland and the
# pinned control server and official client.
VM_ARGS = [
    "--rootfs=$(rootpath @alpine_minirootfs_3_21_7_x86_64//file)",
    "--smolvm=$(rootpath @smolvm_1_7_4_linux_x86_64//:smolvm)",
    "--libkrunfw=$(rootpath //scripts:libkrunfw_networking)",
    "--guest=$(rootpath :guest-controller.sh)",
    "--headscale=$(rootpath @headscale_0_29_3_linux_amd64//file)",
    "--tailscale=$(rootpath @tailscale_1_94_2_linux_amd64//:tailscale)",
    "--tailscaled=$(rootpath @tailscale_1_94_2_linux_amd64//:tailscaled)",
    "--headscale-config=$(rootpath :headscale.yaml)",
] + ["--apk=$(rootpath %s)" % apk for apk in APK_FILES]

VM_DATA = APK_FILES + [
    ":guest-controller.sh",
    ":headscale.yaml",
    "//scripts:libkrunfw_networking",
    "@alpine_minirootfs_3_21_7_x86_64//file",
    "@headscale_0_29_3_linux_amd64//file",
    "@smolvm_1_7_4_linux_x86_64//:bundle",
    "@smolvm_1_7_4_linux_x86_64//:smolvm",
    "@tailscale_1_94_2_linux_amd64//:tailscale",
    "@tailscale_1_94_2_linux_amd64//:tailscaled",
]

VM_TAGS = [
    "exclusive-if-local",
    "no-cache",
    "no-remote",
]

sh_test(
    name = "privileged_lab",
    srcs = ["privileged-smolvm.sh"],
    args = VM_ARGS + [
        "--conformance=$(rootpath //crates/ts-conformance:conformance_static)",
        "--harness=$(rootpath //harness:harness)",
        "--ssh-server=$(rootpath //crates/tailfeather-ssh:live_server_static)",
        "--ssh-network=$(rootpath :ssh-network.sh)",
        "--reactor-node=$(rootpath //crates/tailfeather-reactor:lab_node_static)",
        "--reactor-rebind=$(rootpath :reactor-rebind.sh)",
        "--nat-matrix=$(rootpath :nat-matrix.sh)",
        "--responder=$(rootpath //crates/wirefeather:responder_static)",
        "--interop=$(rootpath //scripts:interop-wireguard.sh)",
        "--nostd-interop=$(rootpath //scripts:nostd-interop.sh)",
        "--expectations=$(rootpath //tests/expectations:lab.json)",
        "--vectors=$(rootpath //tests/vectors:versions.json)",
    ],
    data = VM_DATA + [
        "//crates/ts-conformance:conformance_static",
        "//crates/wirefeather:responder_static",
        "//harness:harness",
        "//crates/tailfeather-ssh:live_server_static",
        "ssh-network.sh",
        "reactor-rebind.sh",
        "nat-matrix.sh",
        "//crates/tailfeather-reactor:lab_node_static",
        "//scripts:interop-wireguard.sh",
        "//scripts:nostd-interop.sh",
        "//tests/expectations:lab.json",
        "//tests/vectors:vectors",
        "//tests/vectors:versions.json",
    ],
    size = "enormous",
    tags = VM_TAGS,
    # Sequential budgets: conformance 360s, WireGuard 120s, no-std 180s. The
    # network phase runs concurrently and is bounded by its slowest stage
    # (SSH over a blocked UDP path, 540s; the NAT matrix, 1200s). The VM caps
    # the total at 2400s.
    timeout = "eternal",
)

# The differential NAT-traversal matrix alone: Tailfeather against the
# official client in every NAT topology and mid-session event, plus bulk
# throughput and Tailscale SSH. It builds only the reactor node and the SSH
# console server, so it is cheap enough to run on every relevant change.
sh_test(
    name = "nat_matrix",
    srcs = ["privileged-smolvm.sh"],
    args = VM_ARGS + [
        "--stages=nat-matrix",
        "--reactor-node=$(rootpath //crates/tailfeather-reactor:lab_node_static)",
        "--ssh-server=$(rootpath //crates/tailfeather-ssh:live_server_static)",
        "--nat-matrix=$(rootpath :nat-matrix.sh)",
    ],
    data = VM_DATA + [
        "nat-matrix.sh",
        "//crates/tailfeather-reactor:lab_node_static",
        "//crates/tailfeather-ssh:live_server_static",
    ],
    size = "enormous",
    tags = VM_TAGS,
    # The guest bounds the matrix stage at 1200s.
    timeout = "eternal",
)

# The production ESP32-C6 firmware in ESP-EMU as a Headscale exit node, with
# IPv4 TCP throughput through it. Build with --config=optimized so the
# firmware runs at production optimization:
#
#   bazel test --config=optimized //tests/lab:esp_exit --test_output=streamed
#
# TF_ESP_EXIT_* knobs (see esp-exit.sh) pass through --test_env.
sh_test(
    name = "esp_exit",
    srcs = ["privileged-smolvm.sh"],
    args = VM_ARGS + [
        "--stages=esp-exit",
        "--esp-emu=$(rootpath @esp_emu_0_50_0_linux_x86_64//:esp-emu)",
        "--esp-flash=$(rootpath //firmware:emulab_flash)",
        "--esp-elf=$(rootpath //firmware:esp_gateway_firmware_emulab)",
        "--esp-exit=$(rootpath :esp-exit.sh)",
    ],
    data = VM_DATA + [
        "esp-exit.sh",
        "//firmware:emulab_flash",
        "//firmware:esp_gateway_firmware_emulab",
        "@esp_emu_0_50_0_linux_x86_64//:esp-emu",
    ],
    size = "enormous",
    tags = VM_TAGS + ["manual"],
    timeout = "eternal",
)

# The same stage against the production build (//firmware:emulab_tls_flash):
# NTP time bootstrap, TLS 1.3 control and DERP verified against the pinned lab
# CA in esp-tls/, Noise, HTTP/2. Its stack high-water mark is what the
# firmware resource contract's STACK_FLOOR is measured from.
sh_test(
    name = "esp_exit_tls",
    srcs = ["privileged-smolvm.sh"],
    args = VM_ARGS + [
        "--stages=esp-exit-tls",
        "--esp-emu=$(rootpath @esp_emu_0_50_0_linux_x86_64//:esp-emu)",
        "--esp-flash=$(rootpath //firmware:emulab_tls_flash)",
        "--esp-elf=$(rootpath //firmware:esp_gateway_firmware_emulab_tls)",
        "--esp-exit=$(rootpath :esp-exit.sh)",
        "--esp-tls=$(rootpath :esp-tls/control.pem)",
    ],
    data = VM_DATA + [
        "esp-exit.sh",
        "esp-tls/ca.pem",
        "esp-tls/control.key",
        "esp-tls/control.pem",
        "//firmware:emulab_tls_flash",
        "//firmware:esp_gateway_firmware_emulab_tls",
        "@esp_emu_0_50_0_linux_x86_64//:esp-emu",
    ],
    size = "enormous",
    tags = VM_TAGS + ["manual"],
    timeout = "eternal",
)
